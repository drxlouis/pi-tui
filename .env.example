# Copy this file to .env and fill in your own values.
# `.env` is gitignored, so your personal settings never get committed.

# Your calendar's secret iCal feed URL, used by the Calendar tab and the Home overview.
# Google Calendar: Settings and sharing -> your calendar -> "Secret address in iCal format".
# Leave empty to disable the Calendar tab (it will show a setup message instead of erroring).
CALENDAR_ICS_URL=

# City used for the Weather widget on the Home tab (geocoded via Open-Meteo, no API key needed).
# Defaults to "Brussels" if left empty.
WEATHER_CITY=
